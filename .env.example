# Телеграм-бот
TELEGRAM_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# Пароль для авторизации в боте.
# Если не задан — бот работает без авторизации (открыт для всех).
# BOT_PASSWORD=your_secret_password

# Опционально: при первом запуске бот автоматически подпишет этот чат на рассылку.
# В дальнейшем подписка управляется через кнопку в боте (/menu → 🔔 Подписаться).
# CHAT_ID=123456789

# Сколько месяцев хранить файлы фидбека (по умолчанию 3)
# FEEDBACK_RETENTION_MONTHS=3

# Сколько дней хранить файлы отчётов (по умолчанию 30)
# REPORT_RETENTION_DAYS=30

# Сколько дней хранить лог-файлы (по умолчанию 90)
# LOG_RETENTION_DAYS=90

# Кэш данных API в минутах (по умолчанию 30).
# Повторный запрос к WB API не делается, пока данные свежее этого значения.
# DATA_CACHE_TTL=30

# Ключ обфускации токенов в БД (произвольная строка).
# Если не задан — используется значение по умолчанию.
# TOKEN_OBF_KEY=my-secret-key

# Wildberries API (опционально — для автомиграции первого магазина)
# Токены магазинов теперь добавляются через бот: /menu → Настройки → Магазины
# WB_TOKEN=ваш_токен_wb_api
