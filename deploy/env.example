# Переменные демо-деплоя wb_analiz на Spark. Скопировать в deploy/.env, chmod 600 (.env в .gitignore).
MEM_LIMIT=512m

TELEGRAM_TOKEN=              # токен ДЕМО-бота (не бота заказчика — у того свой поллер)
TELEGRAM_PROXY=http://192.168.20.41:8088   # sing-box на LAN-IP Spark: путь контейнеров к api.telegram.org; при смене IP поправить
WB_TOKEN=                    # токен продавца Wildberries
BOT_PASSWORD=                # пароль входа в бота
CHAT_ID=                     # чат для рассылок по расписанию (для демо — чат владельца)
